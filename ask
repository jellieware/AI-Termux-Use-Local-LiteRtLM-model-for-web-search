#!/usr/bin/env python3

import sys
import json
import urllib.request
import urllib.parse
import urllib.error
import re
import html
from datetime import datetime

import litert_lm


# ============================================================
# OPTIONAL DDGS SEARCH
#
# If installed, this is preferred:
#
#     pip install -U ddgs
#
# The program will still work without it by falling back
# to DuckDuckGo's HTML search.
# ============================================================

try:
    from ddgs import DDGS
    DDGS_AVAILABLE = True
except Exception:
    DDGS_AVAILABLE = False


# ============================================================
# SETTINGS
# ============================================================

MAX_RESULTS = 8
SEARCH_TIMEOUT = 20

USER_AGENT = (
    "Mozilla/5.0 (Linux; Android 10; K) "
    "AppleWebKit/537.36 "
    "(KHTML, like Gecko) "
    "Chrome/151.0.0.0 Mobile Safari/537.36"
)


# ============================================================
# PRINT SEARCH STATUS
# ============================================================

def search_status(message, color="yellow"):

    colors = {
        "yellow": "\x1b[33m",
        "green": "\x1b[32m",
        "red": "\x1b[31m",
        "cyan": "\x1b[36m",
        "reset": "\x1b[0m",
    }

    print(
        colors.get(color, "")
        + message
        + colors["reset"],
        file=sys.stderr
    )


# ============================================================
# CLEAN HTML
# ============================================================

def clean_html(text):

    if not text:
        return ""

    text = re.sub(
        r"<script\b[^>]*>.*?</script>",
        " ",
        text,
        flags=re.I | re.S
    )

    text = re.sub(
        r"<style\b[^>]*>.*?</style>",
        " ",
        text,
        flags=re.I | re.S
    )

    text = re.sub(
        r"<[^>]+>",
        " ",
        text
    )

    text = html.unescape(text)

    text = re.sub(
        r"\s+",
        " ",
        text
    )

    return text.strip()


# ============================================================
# DECODE DUCKDUCKGO URL
# ============================================================

def decode_ddg_url(url):

    if not url:
        return ""

    url = html.unescape(url)

    try:

        parsed = urllib.parse.urlparse(url)

        params = urllib.parse.parse_qs(
            parsed.query
        )

        if "uddg" in params:

            return urllib.parse.unquote(
                params["uddg"][0]
            )

    except Exception:
        pass

    return url


# ============================================================
# DDGS SEARCH
# ============================================================

def search_with_ddgs(query):

    if not DDGS_AVAILABLE:
        return []

    results = []

    try:

        search_status(
            "[Using DDGS search engine]",
            "cyan"
        )

        with DDGS() as ddgs:

            # ------------------------------------------------
            # Detect news queries.
            # ------------------------------------------------

            is_news = any(
                word in query.lower()
                for word in [
                    "news",
                    "headline",
                    "headlines",
                    "top stories",
                    "breaking",
                    "latest news"
                ]
            )

            if is_news:

                try:

                    items = ddgs.news(
                        query,
                        region="us-en",
                        safesearch="moderate",
                        timelimit="d",
                        max_results=MAX_RESULTS
                    )

                except Exception:

                    # Some DDGS versions have slightly
                    # different parameters.
                    items = ddgs.news(
                        query,
                        max_results=MAX_RESULTS
                    )

            else:

                try:

                    items = ddgs.text(
                        query,
                        region="us-en",
                        safesearch="moderate",
                        max_results=MAX_RESULTS
                    )

                except Exception:

                    items = ddgs.text(
                        query,
                        max_results=MAX_RESULTS
                    )

            for item in items:

                if not isinstance(item, dict):
                    continue

                title = (
                    item.get("title")
                    or item.get("heading")
                    or ""
                )

                url = (
                    item.get("href")
                    or item.get("url")
                    or ""
                )

                snippet = (
                    item.get("body")
                    or item.get("snippet")
                    or item.get("description")
                    or ""
                )

                title = clean_html(
                    str(title)
                )

                url = decode_ddg_url(
                    str(url)
                )

                snippet = clean_html(
                    str(snippet)
                )

                if not title and not url:
                    continue

                results.append({
                    "title": title,
                    "url": url,
                    "snippet": snippet,
                })

                if len(results) >= MAX_RESULTS:
                    break

    except Exception as e:

        search_status(
            f"[DDGS failed: {e}]",
            "red"
        )

        return []

    return results


# ============================================================
# DUCKDUCKGO HTML SEARCH
#
# Fallback if ddgs is not installed or fails.
# ============================================================

def search_with_duckduckgo_html(query):

    results = []

    headers = {
        "User-Agent": USER_AGENT,
        "Accept": (
            "text/html,application/xhtml+xml,"
            "application/xml;q=0.9,*/*;q=0.8"
        ),
        "Accept-Language": "en-US,en;q=0.9",
        "Cache-Control": "no-cache",
        "Pragma": "no-cache",
    }

    encoded = urllib.parse.urlencode({
        "q": query,
        "kl": "us-en",
    })

    search_urls = [
        "https://html.duckduckgo.com/html/?" + encoded,
        "https://lite.duckduckgo.com/lite/?" + encoded,
        "https://duckduckgo.com/?" + encoded,
    ]

    for search_url in search_urls:

        try:

            search_status(
                "[Trying DuckDuckGo HTML search]",
                "cyan"
            )

            request = urllib.request.Request(
                search_url,
                headers=headers,
                method="GET"
            )

            with urllib.request.urlopen(
                request,
                timeout=SEARCH_TIMEOUT
            ) as response:

                page = response.read().decode(
                    "utf-8",
                    errors="replace"
                )

            if not page:
                continue

            # =================================================
            # STANDARD RESULT FORMAT
            # =================================================

            matches = re.findall(
                r'<a[^>]+class=["\']result__a["\'][^>]+'
                r'href=["\']([^"\']+)["\'][^>]*>'
                r'(.*?)'
                r'</a>',
                page,
                flags=re.I | re.S
            )

            for href, title_html in matches:

                title = clean_html(
                    title_html
                )

                url = decode_ddg_url(
                    href
                )

                if not title:
                    continue

                # Try to find the snippet following the title.
                snippet = ""

                title_position = page.find(
                    title_html
                )

                if title_position >= 0:

                    surrounding = page[
                        title_position:
                        title_position + 5000
                    ]

                    snippet_match = re.search(
                        r'class=["\']result__snippet["\'][^>]*>'
                        r'(.*?)'
                        r'</',
                        surrounding,
                        flags=re.I | re.S
                    )

                    if snippet_match:

                        snippet = clean_html(
                            snippet_match.group(1)
                        )

                results.append({
                    "title": title,
                    "url": url,
                    "snippet": snippet,
                })

                if len(results) >= MAX_RESULTS:
                    break

            if results:
                return results

            # =================================================
            # SECONDARY PARSER
            # =================================================

            links = re.findall(
                r'<a[^>]+href=["\']([^"\']+)["\'][^>]*>'
                r'(.*?)'
                r'</a>',
                page,
                flags=re.I | re.S
            )

            for href, title_html in links:

                title = clean_html(
                    title_html
                )

                url = decode_ddg_url(
                    href
                )

                if not title:
                    continue

                if len(title) < 3:
                    continue

                if not url.startswith(
                    ("http://", "https://")
                ):
                    continue

                if (
                    "duckduckgo.com" in url
                    and "uddg=" not in href
                ):
                    continue

                results.append({
                    "title": title,
                    "url": url,
                    "snippet": "",
                })

                if len(results) >= MAX_RESULTS:
                    break

            if results:
                return results

        except urllib.error.HTTPError as e:

            search_status(
                f"[DuckDuckGo HTTP error {e.code}]",
                "red"
            )

        except urllib.error.URLError as e:

            search_status(
                f"[DuckDuckGo network error: {e.reason}]",
                "red"
            )

        except Exception as e:

            search_status(
                f"[DuckDuckGo error: {e}]",
                "red"
            )

    return []


# ============================================================
# WEB SEARCH
# ============================================================

def web_search(query):

    query = str(query).strip()

    if not query:
        return ""

    # --------------------------------------------------------
    # Try maintained DDGS package first.
    # --------------------------------------------------------

    results = search_with_ddgs(
        query
    )

    # --------------------------------------------------------
    # Fallback to direct DuckDuckGo HTML.
    # --------------------------------------------------------

    if not results:

        search_status(
            "[DDGS unavailable/failed; using direct search]",
            "yellow"
        )

        results = search_with_duckduckgo_html(
            query
        )

    # --------------------------------------------------------
    # No results.
    # --------------------------------------------------------

    if not results:

        search_status(
            "[WEB SEARCH RETURNED ZERO RESULTS]",
            "red"
        )

        return ""

    # --------------------------------------------------------
    # Format results.
    # --------------------------------------------------------

    output = []

    output.append(
        "LIVE WEB SEARCH RESULTS"
    )

    output.append(
        "========================"
    )

    output.append(
        f"Search query: {query}"
    )

    output.append("")

    for index, result in enumerate(
        results,
        1
    ):

        title = result.get(
            "title",
            ""
        )

        url = result.get(
            "url",
            ""
        )

        snippet = result.get(
            "snippet",
            ""
        )

        output.append(
            f"RESULT {index}"
        )

        output.append(
            f"TITLE: {title}"
        )

        output.append(
            f"URL: {url}"
        )

        if snippet:

            output.append(
                f"SNIPPET: {snippet}"
            )

        output.append("")

    output.append(
        "END WEB SEARCH RESULTS"
    )

    return "\n".join(output)


# ============================================================
# DETERMINE IF WEB SEARCH IS NEEDED
# ============================================================

def needs_web_search(prompt):

    prompt_lower = prompt.lower()

    triggers = [

        # Time-sensitive
        "today",
        "tonight",
        "yesterday",
        "tomorrow",
        "right now",
        "currently",
        "current",
        "latest",
        "recent",
        "recently",
        "this week",
        "this month",
        "this year",

        # News
        "news",
        "headlines",
        "headline",
        "breaking",
        "top stories",
        "top news",
        "latest news",

        # Weather
        "weather",
        "forecast",

        # Explicit web request
        "search",
        "search the web",
        "search online",
        "look up",
        "look online",
        "find online",
        "find on the web",
        "internet",

        # Common current-information questions
        "who is",
        "what happened",
        "what's happening",
        "what is happening",

        # Years
        "2024",
        "2025",
        "2026",
    ]

    return any(
        trigger in prompt_lower
        for trigger in triggers
    )


# ============================================================
# MAKE BETTER SEARCH QUERY
# ============================================================

def make_search_query(prompt):

    query = prompt.strip()

    lower_query = query.lower()

    remove_phrases = [

        "can you",
        "could you",
        "would you",
        "please",
        "tell me",
        "tell me about",
        "what are",
        "what is",
        "what's",
        "give me",
        "show me",
        "search for",
        "search the web for",
        "search online for",
        "look up",
        "look online for",
        "find information about",
        "find information on",
        "find online",
    ]

    for phrase in remove_phrases:

        lower_query = lower_query.replace(
            phrase,
            ""
        )

    lower_query = re.sub(
        r"\s+",
        " ",
        lower_query
    ).strip()

    if not lower_query:
        lower_query = query

    # --------------------------------------------------------
    # Make news queries more useful.
    # --------------------------------------------------------

    is_news = any(
        word in lower_query.lower()
        for word in [
            "news",
            "headline",
            "headlines",
            "top stories",
            "breaking"
        ]
    )

    is_current = any(
        word in lower_query.lower()
        for word in [
            "today",
            "latest",
            "current",
            "recent",
            "right now"
        ]
    )

    current_year = str(
        datetime.now().year
    )

    if (
        (is_news or is_current)
        and current_year not in lower_query
    ):

        lower_query += (
            " "
            + current_year
        )

    return lower_query


# ============================================================
# BUILD LLM PROMPT WITH WEB RESULTS
# ============================================================

def build_web_prompt(
    user_prompt,
    web_context
):

    return f"""
You are answering a user using LIVE WEB SEARCH RESULTS.

The user specifically asked a question that may require
current information.

IMPORTANT RULES:

1. The web search results below ARE real external search
   results supplied to you by the application.

2. USE those results to answer the user.

3. DO NOT say:
   "I don't have access to real-time information."

4. DO NOT say:
   "I cannot access the internet."

5. DO NOT say:
   "I don't have live news feeds."

6. Do not invent sources, URLs, facts, or events.

7. If the search results do not contain enough information,
   say that the search results were insufficient.

8. When discussing current news, use the dates and information
   contained in the results whenever available.

9. You may summarize and combine information from multiple
   search results.

10. The original user question is the final authority for
    what you should answer.

LIVE WEB SEARCH RESULTS:
========================

{web_context}

========================

USER QUESTION:
{user_prompt}

Answer the user's question now.
""".strip()


# ============================================================
# MAIN
# ============================================================

def main():

    if len(sys.argv) < 2:

        print(
            'Usage: ask "Your question here"',
            file=sys.stderr
        )

        sys.exit(1)

    user_prompt = " ".join(
        sys.argv[1:]
    ).strip()

    if not user_prompt:

        print(
            "No question supplied.",
            file=sys.stderr
        )

        sys.exit(1)

    # ========================================================
    # MODEL PATH
    # ========================================================

    model_path = (
        "/storage/emulated/0/"
        "gemma-4-E2B-it.litertlm"
    )

    # ========================================================
    # LITERT LOGGING
    # ========================================================

    litert_lm.set_min_log_severity(
        litert_lm.LogSeverity.ERROR
    )

    # ========================================================
    # DEFAULT PROMPT
    # ========================================================

    final_input_text = user_prompt

    # ========================================================
    # WEB SEARCH
    # ========================================================

    if needs_web_search(
        user_prompt
    ):

        search_query = make_search_query(
            user_prompt
        )

        search_status(
            f"[Searching the web: {search_query}]",
            "yellow"
        )

        web_context = web_search(
            search_query
        )

        if web_context:

            search_status(
                "[Web search succeeded]",
                "green"
            )

            final_input_text = build_web_prompt(
                user_prompt,
                web_context
            )

        else:

            search_status(
                "[Web search failed]",
                "red"
            )

            # ------------------------------------------------
            # IMPORTANT:
            #
            # Do NOT give Gemma the original current-events
            # question and allow it to hallucinate an answer
            # saying it has no internet.
            # ------------------------------------------------

            final_input_text = f"""
The application attempted to perform a live web search,
but the search returned no usable results.

Do NOT invent current information.

Tell the user that the live web search failed and that
there were no usable web results available.

USER QUESTION:
{user_prompt}
""".strip()

    # ========================================================
    # RUN LITERT-LM
    # ========================================================

    try:

        with litert_lm.Engine(
            model_path,
            backend=litert_lm.Backend.CPU()
        ) as engine:

            with engine.create_conversation() as conversation:

                response = conversation.send_message(
                    final_input_text
                )

                # =================================================
                # EXTRACT RESPONSE
                # =================================================

                raw_text = ""

                if isinstance(
                    response,
                    dict
                ):

                    content = response.get(
                        "content"
                    )

                    if isinstance(
                        content,
                        dict
                    ):

                        raw_text = content.get(
                            "text",
                            ""
                        )

                    elif content is not None:

                        raw_text = str(
                            content
                        )

                elif hasattr(
                    response,
                    "text"
                ):

                    raw_text = response.text

                else:

                    raw_text = str(
                        response
                    )

                # =================================================
                # HANDLE EMPTY RESPONSE
                # =================================================

                if not raw_text:

                    print(
                        "No response generated.",
                        file=sys.stderr
                    )

                    sys.exit(1)

                # =================================================
                # CLEAN ESCAPED NEWLINES
                # =================================================

                raw_text = raw_text.replace(
                    "\\r\\n",
                    "\n"
                )

                raw_text = raw_text.replace(
                    "\\n",
                    "\n"
                )

                # =================================================
                # CLEAN ACCIDENTAL JSON WRAPPER
                # =================================================

                stripped = raw_text.strip()

                if (
                    stripped.startswith("[")
                    and stripped.endswith("]")
                ):

                    try:

                        parsed = json.loads(
                            stripped
                        )

                        if isinstance(
                            parsed,
                            list
                        ):

                            pieces = []

                            for item in parsed:

                                if isinstance(
                                    item,
                                    dict
                                ):

                                    text = item.get(
                                        "text"
                                    )

                                    if text:
                                        pieces.append(
                                            str(text)
                                        )

                                elif isinstance(
                                    item,
                                    str
                                ):

                                    pieces.append(
                                        item
                                    )

                            if pieces:

                                raw_text = "\n".join(
                                    pieces
                                )

                    except Exception:
                        pass

                # =================================================
                # OUTPUT
                # =================================================

                print(
                    raw_text.strip()
                )

    except Exception as e:

        print(
            f"LiteRT-LM error: {e}",
            file=sys.stderr
        )

        sys.exit(1)


# ============================================================
# ENTRY POINT
# ============================================================

if __name__ == "__main__":
    main()